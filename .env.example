# Copy to .env (git-ignored) and fill in ONE of the options below. Leave everything empty to run without a model:
# the inbox shows stored results, and new checks say "the AI is off".

# Option 1: Azure OpenAI / Azure AI Foundry
#   endpoint: https://<resource>.services.ai.azure.com/openai/v1  or  https://<resource>.openai.azure.com/
#   sign in with `az login` (your account needs the "Cognitive Services OpenAI User" role on the resource),
#   or set NHTSA_AZURE_API_KEY instead.
NHTSA_AZURE_ENDPOINT=
NHTSA_DEPLOYMENT=
NHTSA_AZURE_API_KEY=

# Option 2: OpenAI (used only when NHTSA_AZURE_ENDPOINT is empty)
NHTSA_OPENAI_API_KEY=
NHTSA_OPENAI_MODEL=
