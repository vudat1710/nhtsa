# Copy to .env. No secrets: Azure auth is Entra ID via `az login` (DefaultAzureCredential).

# replay = recorded answers only (no network) | record = call the model and save answers | live = call, save nothing
NHTSA_LLM_MODE=replay

# Azure AI Foundry / Azure OpenAI: https://<resource>.services.ai.azure.com/openai/v1  or  https://<resource>.openai.azure.com/
NHTSA_AZURE_ENDPOINT=
NHTSA_DEPLOYMENT=
